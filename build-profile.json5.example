{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/PATH/TO/YOUR/SIGNING/FILE",
          "keyAlias": "debugKey",
          "keyPassword": "YOUR_ENCRYPTED_PASSWORD",
          "profile": "/PATH/TO/YOUR/SIGNING/FILE",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/PATH/TO/YOUR/SIGNING/FILE",
          "storePassword": "YOUR_ENCRYPTED_PASSWORD"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}